{
	"name": "agent-agent",
	"displayName": "Agent",
	"publisher": "agent",
	"description": "Agentic coding assistant for your workspace.",
	"version": "1.0.1",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"Machine Learning",
		"Programming Languages"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "agent.start",
				"title": "Start Agent"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "agent-sidebar",
					"title": "Agent",
					"icon": "resources/icon.svg"
				}
			]
		},
		"views": {
			"agent-sidebar": [
				{
					"type": "webview",
					"id": "agent.chatView",
					"name": "Chat"
				}
			]
		},
		"configuration": {
			"title": "Agent",
			"properties": {
				"agent.apiUrl": {
					"type": "string",
					"default": "https://ai.storeglance.com/api",
					"description": "Base URL for the Agent API (the /api route of the Agent web host). For UAT use https://uat-ai.storeglance.com/api."
				},
				"agent.tenantDomain": {
					"type": "string",
					"default": "",
					"description": "Your tenant domain (e.g. acme.storeglanceai.com), sent as X-Tenant-Domain so the API routes to your tenant. Leave blank for the default/single-tenant instance."
				},
				"agent.workspaceMode": {
					"type": "string",
					"enum": [
						"local",
						"cloud"
					],
					"default": "local",
					"description": "Workspace mode: 'local' = file tools run on your machine (Local Server), 'cloud' = everything runs on VPS (Cloud Server)"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:webview": "cd webview-ui && npm run dev",
		"package": "npm run build:webview && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src --ext ts",
		"test": "vscode-test",
		"build:webview": "cd webview-ui && npm run build"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "18.x",
		"@types/vscode": "^1.120.0",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"esbuild": "^0.20.2",
		"eslint": "^8.57.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"ws": "^8.18.0"
	}
}
